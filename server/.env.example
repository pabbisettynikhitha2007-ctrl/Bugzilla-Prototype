# Signal Bug Tracker — Server Environment Variables

# Server port (optional, defaults to 4000)
PORT=4000

# JWT secret key — CHANGE THIS in production to a long random string
JWT_SECRET=change-me-to-a-long-random-secret

# GitHub Webhook Integration (optional)
# Set GITHUB_WEBHOOK_SECRET to the secret you configure in GitHub:
#   Settings → Webhooks → Secret
# Leave empty to skip signature verification (development only)
GITHUB_WEBHOOK_SECRET=

# Webhook endpoint: POST http://localhost:4000/api/bugs/github/webhook
# Content type: application/json
# Events to subscribe: "Pull requests"
